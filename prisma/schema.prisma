generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Hole      Hole[]
  Round     Round[]
}

model Hole {
  id        String   @id @default(cuid())
  courseId  String
  number    Int
  par       Int
  yardage   Int?
  createdAt DateTime @default(now())
  Course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, number])
  @@index([courseId])
}

model Mulligan {
  id          String      @id @default(cuid())
  roundId     String
  playerId    String
  holeNumber  Int
  createdAt   DateTime    @default(now())
  RoundPlayer RoundPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  Round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerId, holeNumber])
  @@index([roundId, playerId])
}

model Round {
  id          String        @id @default(cuid())
  courseId    String
  createdById String
  status      String        @default("active")
  mode        String        @default("stroke")
  wager       String?       // Legacy field, kept for backwards compatibility
  wagers      Json?         // New field for multiple wagers
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Mulligan    Mulligan[]
  Course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User        User          @relation(fields: [createdById], references: [id])
  RoundPlayer RoundPlayer[]
  Score       Score[]
}

model RoundPlayer {
  id               String     @id @default(cuid())
  roundId          String
  name             String
  userId           String?     // Optional link to User account
  mulligansAllowed Int        @default(0)
  Mulligan         Mulligan[]
  Round            Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  User             User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  Score            Score[]
  
  @@index([roundId])
  @@index([userId])
}

model Score {
  id          String      @id @default(cuid())
  roundId     String
  playerId    String
  holeNumber  Int
  score       Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  RoundPlayer RoundPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  Round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerId, holeNumber])
  @@index([roundId, playerId])
}

model Session {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  name        String
  password    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Round       Round[]
  Session     Session[]
  RoundPlayer RoundPlayer[]
}
